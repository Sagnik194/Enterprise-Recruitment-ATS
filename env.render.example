# Set these in Render Dashboard -> Environment; do not upload real secrets.
DATABASE_HOST=your-managed-mysql-host
DATABASE_PORT=3306
DATABASE_USER=your-mysql-user
DATABASE_PASSWORD=replace-me
DATABASE_NAME=recruitment_ats
JWT_SECRET_KEY=generate-random-48-byte-secret
SESSION_SECRET_KEY=generate-a-different-random-48-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_HTTPS_ONLY=true
